# ─────────────────────────────────────────────
# TruthLens Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# ── SQLite Database ───────────────────────────
DATABASE_URL=sqlite:///./truthlens.db

# ── HuggingFace Inference API ───────────────
# Get a free token at https://huggingface.co/settings/tokens
# Leave blank to use the built-in rule-based fallback analyzer
HUGGINGFACE_API_TOKEN=

# ── News API (optional – mock data used if blank) ──
NEWS_API_KEY=

# ── Google Fact Check API (optional) ────────
GOOGLE_FACT_CHECK_API_KEY=

# ── App Settings ────────────────────────────
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
SECRET_KEY=change_me_to_a_random_secret_key
